{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/background", "destination": "/#experience", "permanent": false },
    { "source": "/off-the-grid", "destination": "/#outside", "permanent": false },
    { "source": "/contact", "destination": "/#contact", "permanent": false },
    { "source": "/ordo-desktop", "destination": "/builds#ordo-desktop", "permanent": false }
  ],
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/og.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
